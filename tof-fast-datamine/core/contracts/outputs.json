{
  "schemaVersion": 2,
  "publicationRoots": ["release-manifest.json", "data/export-version.json", "data/datamine-summary.json", "items/data", "seq/data", "fce/data", "fce/docs", "oow/data"],
  "managed": [
    { "path": "release-manifest.json", "producer": "generate-release-manifest.js", "required": true },
    { "path": "data/export-version.json", "producer": "generate-release-manifest.js", "required": true },
    { "path": "data/datamine-summary.json", "producer": "generate-release-manifest.js", "required": true },
    { "path": "items/data/merged_mapping_with_original.json", "producer": "build-items-json.js", "required": true },
    { "path": "items/data/merged_mapping_with_original_mmo.json", "producer": "build-items-json.js", "required": true },
    { "path": "seq/data/DT_MonsterStaticData_Overseas.json", "producer": "build-seq-data.js", "required": true },
    { "path": "seq/data/seq-boss-cache.json", "producer": "build-seq-data.js", "required": true },
    { "path": "seq/data/seq-stage-limit.txt", "producer": "build-seq-data.js", "required": true },
    { "path": "fce/data/Filtered_Game.json", "producer": "parse-fce-mechanics.js", "required": true },
    { "path": "fce/data/Filtered_Game_ru.json", "producer": "parse-fce-mechanics.js", "required": false },
    { "path": "fce/data/Filtered_Game_Unregistered.json", "producer": "parse-fce-mechanics.js", "required": true },
    { "path": "fce/data/Filtered_Game_Unregistered_ru.json", "producer": "parse-fce-mechanics.js", "required": false },
    { "path": "fce/data/Filtered_Game_Unregistered_By_Boss.json", "producer": "parse-fce-mechanics.js", "required": true },
    { "path": "fce/data/Filtered_Game_Unregistered_By_Boss_ru.json", "producer": "parse-fce-mechanics.js", "required": false },
    { "path": "fce/data/fce-unregistered-bosses.json", "producer": "parse-fce-mechanics.js", "required": true },
    { "path": "fce/data/fce-missing-boss-texts.json", "producer": "parse-fce-mechanics.js", "required": true },
    { "path": "fce/data/fce-game-boss-catalog.json", "producer": "parse-fce-mechanics.js", "required": true },
    { "path": "fce/docs/ALL_BOSSES_TEXTS.md", "producer": "parse-fce-mechanics.js", "required": true },
    { "path": "fce/docs/NEW_BOSSES_TEXTS.md", "producer": "parse-fce-mechanics.js", "required": true },
    { "path": "fce/data/fce-index.json", "producer": "build-fce-index.js", "required": true },
    { "path": "oow/data/season_dates.json", "producer": "build-user-stats.js", "required": true },
    { "path": "oow/data/oow_buffs_catalog.json", "producer": "build-user-stats.js", "required": true },
    { "path": "oow/data/index.json", "producer": "shard-oow-data.js", "required": true },
    { "path": "oow/data/current/summary.json", "producer": "shard-oow-data.js", "required": true },
    { "path": "oow/data/seasons", "producer": "shard-oow-data.js", "required": true, "directory": true }
  ],
  "buildIntermediates": [
    "oow/data/oow_stats.json", "oow/data/oow_mmo_stats.json",
    "oow/data/oow_deep_intel.json", "oow/data/oow_current_seasons.json"
  ],
  "curatedPreserve": [
    "items/curated/gacha-overrides.json", "items/curated/mmo-overrides.json",
    "items/curated/gacha-translations.json", "items/curated/mmo-translations.json",
    "seq/data/seq-mechanics-overrides.json", "fce/data/bosses",
    "fce/data/fce-known-boss-text-ids.json"
  ]
}
